# Copy to infra/.env on the VM and fill in. Never commit the filled-in file.
REPO_URL=git@github.com:<you>/devin-kernel-optimiser.git
REPO_NAME=devin-kernel-optimiser
OUTPOST=h100-kernels
# Outpost token from Settings -> Environment -> Outposts (shown once)
DEVIN_OUTPOSTS_TOKEN=
# For infra/launch_agents.py (v3 API, service user or personal token with org.devins.use)
DEVIN_API_KEY=
DEVIN_ORG_ID=org-...
DEVIN_API_BASE=https://api.devin.ai
